{
  "name": "@beatex/prover-wasm",
  "version": "0.1.0",
  "description": "Web Worker hosted WASM prover for BeatEx trader proofs",
  "type": "module",
  "sideEffects": [
    "./dist/worker.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./dist/worker.js"
  },
  "scripts": {
    "build:runtime": "bash ../../scripts/build-trader-wasm.sh",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:wasm": "pnpm build && node --test test/*.integration.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@beatex/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@beatex/sdk": "file:../sdk",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
