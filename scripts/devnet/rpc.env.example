# Copy this file to .devnet/devnet/rpc.env. Never commit the populated file.
BEATEX_RPC_URL=https://api.devnet.solana.com
# The session URL is the primary endpoint for transaction submissions. Read
# requests are round-robin balanced across this URL and every fallback below.
# Submissions stay primary-first and only fail over for transport/HTTP-429
# failures, so deterministic program errors are never replayed elsewhere.
BEATEX_RPC_SESSION_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
BEATEX_RPC_FALLBACK_URLS=https://solana-devnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
