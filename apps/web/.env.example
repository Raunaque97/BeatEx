NEXT_PUBLIC_BEATEX_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_BEATEX_PROGRAM_ID=2P37xv7CzDv7pSet6LaXJDq4m1auW3pZ8PzPLtErfsVd
NEXT_PUBLIC_BEATEX_PROVER_MANIFEST_URL=/beatex-prover-assets/manifest.json
# Auction-history indexer (scripts/devnet/run-indexer.sh).
NEXT_PUBLIC_BEATEX_INDEXER_URL=http://127.0.0.1:8787
# Oracle-free BEAT/tUSD market (scripts/devnet/setup-beat-market.sh); omit to hide it.
NEXT_PUBLIC_BEATEX_BEAT_MARKET=8dE84BMbnqMEHjjJKZZaoS43B3dvA6sKGyquJdeCmX9v

# Server-only faucet settings (never prefix with NEXT_PUBLIC_).
# A funded Devnet wallet holding tBTC and tUSD, as a solana-keygen JSON byte array.
FAUCET_SECRET_KEY=
# Optional: a private RPC for faucet transactions, and per-request drip sizes.
FAUCET_RPC_URL=
FAUCET_BASE_AMOUNT=0.05
FAUCET_QUOTE_AMOUNT=5000
# Wallets under 0.02 SOL are topped up to this amount (fees + order account rent).
FAUCET_SOL_AMOUNT=0.05
