{
  "name": "beatex",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @beatex/sdk --filter @beatex/prover-wasm --filter @beatex/web run dev",
    "dev:web": "pnpm --filter @beatex/web dev",
    "build:contract": "bash scripts/build-pipeline.sh --contract-only",
    "build:protocol": "bash scripts/build-pipeline.sh --skip-wasm --skip-web",
    "build:all": "bash scripts/build-pipeline.sh",
    "build:web": "pnpm --filter @beatex/sdk build && pnpm --filter @beatex/prover-wasm build && pnpm --filter @beatex/web build",
    "assets:web": "node scripts/fetch-web-prover-assets.mjs",
    "build:vercel": "pnpm assets:web && pnpm build:web",
    "test:assets": "node --test scripts/fetch-web-prover-assets.test.mjs",
    "check:web": "pnpm --filter @beatex/sdk check && pnpm --filter @beatex/prover-wasm check && pnpm --filter @beatex/web check",
    "test:web": "pnpm --filter @beatex/web test"
  }
}
